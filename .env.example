# =============================================================================
# game_analysis_agent environment configuration
# =============================================================================
# Copy this file to .env for local development. `.env` is ignored by Git;
# never commit a populated secret file. The placeholders are intentional so
# Replay and offline Judge Mode work without credentials.
# =============================================================================

# -----------------------------------------------------------------------------
# LLM provider selection
# -----------------------------------------------------------------------------
# Options: sglang (default local GPU) | vllm (local fallback) | deepseek (cloud)
LLM_PROVIDER=sglang

# -----------------------------------------------------------------------------
# Local vLLM (retained baseline/fallback)
# -----------------------------------------------------------------------------
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=local-dev-token
# Checkpoint loaded by the vLLM server and the stable model id exposed by its
# OpenAI-compatible API. The Python client and Compose share the served name.
LLM_MODEL=nvidia/Qwen3.6-27B-NVFP4
LLM_SERVED_MODEL_NAME=qwen3.6-27b-nvfp4

# -----------------------------------------------------------------------------
# Local SGLang (default local backend)
# -----------------------------------------------------------------------------
SGLANG_BASE_URL=http://localhost:30000/v1
SGLANG_API_KEY=local-dev-token
SGLANG_MODEL_PATH=RadixArk/Qwen3.8-27B-NVFP4
SGLANG_MODEL_REVISION=554ebba9b5f1b79dc11246341960360e6ef05ef4
SGLANG_MODEL=qwen3.8-27b

# -----------------------------------------------------------------------------
# DeepSeek (cloud fallback, OpenAI-compatible)
# -----------------------------------------------------------------------------
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_API_KEY=REPLACE_ME

# Agent generation defaults.
AGENT_TEMPERATURE=0.2
AGENT_MAX_TOKENS=4096

# -----------------------------------------------------------------------------
# Dashboard persona provider (server-side only)
# -----------------------------------------------------------------------------
# auto selects OpenAI when OPENAI_API_KEY is present, otherwise it selects the
# hash-pinned Replay provider before a campaign starts. The browser never reads
# or stores this key. Options: auto | openai | replay | vllm | sglang | deepseek
PERSONA_PROVIDER=auto
# Standard server-side credential used by the official OpenAI SDK. The SDK
# calls https://api.openai.com/v1/responses by default. Do not rename this to a
# VITE_* variable and do not expose it to the browser.
OPENAI_API_KEY=
# Keep the exact configured model slug in retained provider evidence.
OPENAI_PERSONA_MODEL=gpt-5.6-luna
PERSONA_REPLAY_MANIFEST=config/build_week_2026_replay.json
PERSONA_MAX_RUNS=12
PERSONA_MAX_WEEKS=20
PERSONA_MAX_CONCURRENCY=4
PERSONA_MAX_CALLS=600
PERSONA_MAX_RETRIES=1
PERSONA_RETRY_BACKOFF_SECONDS=0.5

# Interactive player tool loop
# Local Qwen decision calls default to the paired-quality-verified direct mode.
# Set this to 1 together with a 5120 decision budget for the optional extended-
# reasoning diagnostic. Event-choice calls always use a short constrained budget.
PERSONA_ENABLE_THINKING=0
PERSONA_DECISION_MAX_TOKENS=2048
PERSONA_EVENT_MAX_TOKENS=64
TOOL_MAX_ROUNDS=8

# -----------------------------------------------------------------------------
# Godot CLI defaults
# -----------------------------------------------------------------------------
# Use the compose-aware wrapper by default; set `godot4` for a native install.
GODOT_BIN=scripts/godot-docker-wrapper
# Container fallback/sidecar used by scripts/godot-docker-wrapper.
GODOT_DOCKER_IMAGE=barichello/godot-ci:4.4
# Parent of this repository. The sidecar mounts it at the identical absolute
# path so both the prepared embedded runtime and Agent output work.
# GODOT_DOCKER_MOUNT_ROOT=/abs/path/to/parent/of/this/repository
# Optional external developer override. Judge/CI prepare the embedded demo.
# GAME_PROJECT_PATH=/abs/path/to/writable/game-runtime

# Default Monte Carlo settings
SIM_RUNS=100
SIM_POLICY=balanced
SIM_WEEKS=20
SIM_SEED=42
SIM_DIFFICULTY=normal

# -----------------------------------------------------------------------------
# Docker / local inference container knobs (used by docker-compose.yml)
# -----------------------------------------------------------------------------
# Hugging Face token — required if your model lives behind an auth gate.
HF_TOKEN=

# Host port the vLLM container binds to. Pinned to 8000 to match the
# VLLM_BASE_URL default above. Bump if you already use 8000 elsewhere.
VLLM_BIND_PORT=8000

# Host port for the primary SGLang server. The official SGLang default is
# retained so it can coexist with the vLLM baseline on port 8000.
SGLANG_BIND_PORT=30000

# Operational context target for the 4-persona campaign. Qwen3.8-27B is native
# 262K, while 64K keeps four concurrent runs comfortably bounded.
LLM_MAX_MODEL_LEN=65536

# vLLM continuous batching cap. This is request concurrency, not TP/PP/DP.
LLM_MAX_NUM_SEQS=4

# Optional scheduler-iteration token budget. Leave blank for vLLM auto-tuning;
# this is not the per-request context window.
LLM_MAX_NUM_BATCHED_TOKENS=

# APC-only is the default for the prefill-heavy persona campaign. Qwen3.6's
# hybrid APC remains experimental, so tests must remain correct with APC off.
LLM_ENABLE_PREFIX_CACHING=1
LLM_MAMBA_CACHE_MODE=align
LLM_PREFIX_MATCH_UNIT=16

# MTP speeds long decode but is disabled by default for short structured
# persona outputs and to avoid the unresolved hybrid APC + MTP interaction.
# Enable only in a bounded benchmark after correctness and soak checks pass.
# The tracked inference A/B profiles keep this mutually exclusive with APC.
LLM_ENABLE_MTP=0
LLM_MTP_NUM_SPECULATIVE_TOKENS=3

# Conservative Qwen3.8-27B settings validated on a 128GB DGX Spark. APC uses
# SGLang's Unified Radix Cache; extra_buffer_lazy reduces each request from
# five state slots to four. DFlash2 is the default; config/sglang/dspark.env is
# the rollback. Higher-memory discrete GPUs may override the 0.80 fraction.
SGLANG_MEM_FRACTION_STATIC=0.80
SGLANG_ATTENTION_BACKEND=flashinfer
SGLANG_CHUNKED_PREFILL_SIZE=2048
SGLANG_ENABLE_APC=1
SGLANG_MAMBA_CACHE_STRATEGY=extra_buffer_lazy
SGLANG_IMAGE=lmsysorg/sglang@sha256:d6e7288627be8b02be88e4bba38e73f6d50e2826869f753c13a4c4385ab3eda9
SGLANG_SPECULATIVE_ALGORITHM=DFLASH
SGLANG_DRAFT_MODEL_PATH=incoai/Qwen3.8-27B-DFlash2
SGLANG_DRAFT_MODEL_REVISION=dedf8df68adfb1afeaf7b7480c0a0243108177b4
SGLANG_NUM_DRAFT_TOKENS=8
SGLANG_ENABLE_METRICS=1

# Which GPU the vLLM container should use. Use ``all`` to bind every
# visible device, or set to the index of a single card.
CUDA_VISIBLE_DEVICES=0

# Speed up model downloads from HF Hub via the hf-transfer plugin.
# Optional; set to 1 only if you have the ``hf_transfer`` plugin
# installed in the vLLM container (the default image does).
HF_HUB_ENABLE_HF_TRANSFER=0
