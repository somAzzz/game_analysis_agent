# Arm B: three-token native MTP speculation; prefix caching is disabled.
LLM_MODEL=nvidia/Qwen3.6-27B-NVFP4
LLM_SERVED_MODEL_NAME=qwen3.6-27b-nvfp4
LLM_MAX_MODEL_LEN=65536
LLM_MAX_NUM_SEQS=4
LLM_MAX_NUM_BATCHED_TOKENS=
LLM_GPU_MEMORY_UTILIZATION=0.9
LLM_ENABLE_PREFIX_CACHING=0
# Inactive while APC is off, recorded explicitly to avoid accidental inheritance.
LLM_MAMBA_CACHE_MODE=none
LLM_PREFIX_MATCH_UNIT=16
LLM_ENABLE_MTP=1
LLM_MTP_NUM_SPECULATIVE_TOKENS=3
VLLM_BIND_PORT=8000
CUDA_VISIBLE_DEVICES=0
HF_HUB_ENABLE_HF_TRANSFER=0
